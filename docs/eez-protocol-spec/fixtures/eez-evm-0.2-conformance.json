      "return to parent target",
      "parent CallResult"
    ],
    "revert_survival": {
      "ordinary_target_revert": "target logs are removed; CallResult(false,rawRevertData) survives only if the enclosing entry succeeds",
      "forced_revert_span": "all helper-frame logs are removed; one outer RevertSpanExecuted survives only if the enclosing entry succeeds",
      "failed_lookup": "all lookup-frame logs are removed; a successful parent can later emit CallResult(false,cachedBytes)",
      "top_level_failed_lookup": "the complete manager dispatch reverts and no manager log survives",
      "l1_deferred_nested_miss": "L1ToL2CallNotFound is emitted transiently but never survives the required enclosing-entry revert",
      "l1_immediate_entry_failure": "entry-frame logs are removed; ImmediateEntrySkipped survives only if postAndVerifyBatch succeeds",
      "ancestor_revert": "removes every descendant log, including logs from child frames that had returned successfully"
    }
  },
