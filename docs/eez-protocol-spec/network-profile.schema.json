{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.eez.network/eez/network-profile/2/schema.json",
  "title": "EEZ execution-network profile",
  "description": "Required configuration surface for one EEZ execution network and its direct Ethereum settlement binding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "profile",
    "eez_dependency",
    "ruleset_dependency",
    "chain_identity",
    "settlement_binding",
    "execution_binding",
    "operation",
    "proof_policy",
    "data_availability",
    "governance_recovery",
    "release_blockers"
  ],
  "properties": {
    "$schema": {
      "const": "../eez-protocol-spec/network-profile.schema.json"
    },
    "schema_version": {
      "const": "2"
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "eez_dependency": {
      "$ref": "#/$defs/eez_dependency"
    },
    "ruleset_dependency": {
      "$ref": "#/$defs/ruleset_dependency"
    },
    "chain_identity": {
      "$ref": "#/$defs/chain_identity"
    },
    "settlement_binding": {
      "$ref": "#/$defs/settlement_binding"
    },
    "execution_binding": {
      "$ref": "#/$defs/execution_binding"
    },
    "operation": {
      "$ref": "#/$defs/operation"
    },
    "proof_policy": {
      "$ref": "#/$defs/proof_policy"
    },
    "data_availability": {
      "$ref": "#/$defs/data_availability"
    },
    "governance_recovery": {
      "$ref": "#/$defs/governance_recovery"
    },
    "release_blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
      },
      "uniqueItems": true,
      "description": "The unique set of every nested release-blocker selection ID. Semantic equality is checked by validate_profiles.py."
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "object",
            "properties": {
              "status": {
                "const": "production"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "release_blockers": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "status",
        "role",
        "network_name",
        "environment"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "$ref": "#/$defs/nonempty_string"
        },
        "version": {
          "$ref": "#/$defs/nonempty_string"
        },
        "status": {
          "enum": [
            "draft",
            "development",
            "production"
          ]
        },
        "role": {
          "const": "eez-network"
        },
        "network_name": {
          "$ref": "#/$defs/nonempty_string"
        },
        "environment": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "eez_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framework",
        "evm_binding"
      ],
      "properties": {
        "framework": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "const": "eez-framework"
            },
            "version": {
              "const": "0.1-draft"
            }
          }
        },
        "evm_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "specification",
            "conformance_source"
          ],
          "properties": {
            "id": {
              "const": "eez-evm"
            },
            "version": {
              "const": "0.2-draft"
            },
            "specification": {
              "const": "eez-protocol-spec/index.md"
            },
            "conformance_source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "revision"
              ],
              "properties": {
                "repository": {
                  "const": "eez-core-protocol"
                },
                "revision": {
                  "const": "3a6ca65c4858792fc3a143d34c5484877ef8f68c"
                }
              }
            }
          }
        }
      }
    },
    "ruleset_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "specification",
        "content_digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "specification": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*\\.md$"
        },
        "content_digest": {
          "$ref": "#/$defs/selection_content_digest"
        }
      }
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value",
            "source"
          ],
          "properties": {
            "status": {
              "const": "fixed"
            },
            "value": {
              "not": {
                "type": "null"
              }
            },
            "source": {
              "$ref": "#/$defs/nonempty_string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "id",
            "issue"
          ],
          "properties": {
            "status": {
              "const": "release-blocker"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
            },
            "issue": {
              "$ref": "#/$defs/nonempty_string"
            },
            "source": {
              "$ref": "#/$defs/nonempty_string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "not-applicable"
            },
            "reason": {
              "$ref": "#/$defs/nonempty_string"
            }
          }
        }
      ]
    },
    "fixed_selection": {
      "type": "object",
      "properties": {
        "status": {
          "const": "fixed"
        }
      },
      "required": [
        "status"
      ]
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "nonzero_address": {
      "type": "string",
      "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"
    },
    "nonzero_bytes32": {
      "type": "string",
      "pattern": "^0x(?!0{64}$)[0-9a-fA-F]{64}$"
    },
    "sha256_digest": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "content_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "$ref": "#/$defs/sha256_digest"
        }
      }
    },
    "manager_proof_context_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_block_rule",
        "manager_method",
        "custom_data_encoding",
        "authentication_rule",
        "failure_rule"
      ],
      "properties": {
        "context_block_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "manager_method": {
          "const": "getCustomData(uint64)"
        },
        "custom_data_encoding": {
          "$ref": "#/$defs/nonempty_string"
        },
        "authentication_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "failure_rule": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "header_construction_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_hash",
        "ommers_hash",
        "beneficiary",
        "state_root",
        "transactions_root",
        "receipts_root",
        "logs_bloom",
        "difficulty",
        "number",
        "gas_limit",
        "gas_used",
        "timestamp",
        "extra_data",
        "prev_randao",
        "nonce",
        "base_fee_per_gas",
        "withdrawals_root",
        "blob_gas_fields",
        "parent_beacon_block_root",
        "requests_hash",
        "later_optional_fields",
        "body_rule",
        "validation_rule"
      ],
      "properties": {
        "parent_hash": {
          "$ref": "#/$defs/nonempty_string"
        },
        "ommers_hash": {
          "$ref": "#/$defs/nonempty_string"
        },
        "beneficiary": {
          "$ref": "#/$defs/nonempty_string"
        },
        "state_root": {
          "$ref": "#/$defs/nonempty_string"
        },
        "transactions_root": {
          "$ref": "#/$defs/nonempty_string"
        },
        "receipts_root": {
          "$ref": "#/$defs/nonempty_string"
        },
        "logs_bloom": {
          "$ref": "#/$defs/nonempty_string"
        },
        "difficulty": {
          "$ref": "#/$defs/nonempty_string"
        },
        "number": {
          "$ref": "#/$defs/nonempty_string"
        },
        "gas_limit": {
          "$ref": "#/$defs/nonempty_string"
        },
        "gas_used": {
          "$ref": "#/$defs/nonempty_string"
        },
        "timestamp": {
          "$ref": "#/$defs/nonempty_string"
        },
        "extra_data": {
          "$ref": "#/$defs/nonempty_string"
        },
        "prev_randao": {
          "$ref": "#/$defs/nonempty_string"
        },
        "nonce": {
          "$ref": "#/$defs/nonempty_string"
        },
        "base_fee_per_gas": {
          "$ref": "#/$defs/nonempty_string"
        },
        "withdrawals_root": {
          "$ref": "#/$defs/nonempty_string"
        },
        "blob_gas_fields": {
          "$ref": "#/$defs/nonempty_string"
        },
        "parent_beacon_block_root": {
          "$ref": "#/$defs/nonempty_string"
        },
        "requests_hash": {
          "$ref": "#/$defs/nonempty_string"
        },
        "later_optional_fields": {
          "$ref": "#/$defs/nonempty_string"
        },
        "body_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "validation_rule": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "l1_l2_lowering_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_action_rule",
        "l1_entry_rule",
        "l2_sidecar_rule",
        "explicit_inbound_arguments_rule",
        "system_transaction_rule",
        "validation_rule",
        "failure_rule",
        "conformance_vectors"
      ],
      "properties": {
        "semantic_action_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "l1_entry_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "l2_sidecar_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "explicit_inbound_arguments_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "system_transaction_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "validation_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "failure_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "conformance_vectors": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "string_or_object": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonempty_string"
        },
        {
          "type": "object",
          "minProperties": 1
        }
      ]
    },
    "evm_fork_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_execution_fork",
        "activation",
        "opcode_semantics",
        "validation"
      ],
      "properties": {
        "minimum_execution_fork": {
          "enum": [
            "Cancun",
            "Dencun/Cancun",
            "Prague",
            "Prague/Pectra",
            "Pectra",
            "Osaka"
          ]
        },
        "activation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "genesis"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "const": "block"
                },
                "value": {
                  "$ref": "#/$defs/nonnegative_integer"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "const": "timestamp"
                },
                "value": {
                  "$ref": "#/$defs/nonnegative_integer"
                }
              }
            }
          ]
        },
        "opcode_semantics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transient_storage",
            "blobhash",
            "mcopy"
          ],
          "properties": {
            "transient_storage": {
              "const": "EIP-1153"
            },
            "blobhash": {
              "const": "EIP-4844"
            },
            "mcopy": {
              "const": "EIP-5656"
            }
          }
        },
        "validation": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "runtime_bytecode_hash",
        "deployment_transaction"
      ],
      "properties": {
        "address": {
          "$ref": "#/$defs/nonzero_address"
        },
        "runtime_bytecode_hash": {
          "$ref": "#/$defs/nonzero_bytes32"
        },
        "deployment_transaction": {
          "$ref": "#/$defs/nonzero_bytes32"
        }
      }
    },
    "deployment_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "hash"
      ],
      "properties": {
        "number": {
          "$ref": "#/$defs/positive_integer"
        },
        "hash": {
          "$ref": "#/$defs/nonzero_bytes32"
        }
      }
    },
    "deployment_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/deployment"
      }
    },
    "address_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/nonzero_address"
      }
    },
    "canonical_header_integer_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "field",
        "validation"
      ],
      "properties": {
        "source": {
          "const": "canonical_execution_header"
        },
        "field": {
          "const": "gasLimit"
        },
        "validation": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "proof_system_policy": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "minProperties": 1
          }
        },
        {
          "type": "object",
          "minProperties": 1
        }
      ]
    },
    "proof_routing_mitigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanism",
        "binding_evidence",
        "authenticates_caller",
        "authenticated_calldata_fields",
        "prevents_replay",
        "prevents_front_running",
        "failure_rule"
      ],
      "properties": {
        "mechanism": {
          "$ref": "#/$defs/nonempty_string"
        },
        "binding_evidence": {
          "$ref": "#/$defs/nonempty_string"
        },
        "authenticates_caller": {
          "const": true
        },
        "authenticated_calldata_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty_string"
          },
          "uniqueItems": true
        },
        "prevents_replay": {
          "const": true
        },
        "prevents_front_running": {
          "const": true
        },
        "failure_rule": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "candidate_admission_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "acceptance_rule",
        "invalid_candidate_rule"
      ],
      "properties": {
        "mode": {
          "enum": [
            "permissionless-validity",
            "permissioned"
          ]
        },
        "acceptance_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "invalid_candidate_rule": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "candidate_authentication_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_rule",
        "verification_rule"
      ],
      "properties": {
        "identity_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "verification_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "canonical_candidate_encoding": {
          "$ref": "#/$defs/nonempty_string"
        },
        "digest_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "replay_domain": {
          "$ref": "#/$defs/nonempty_string"
        },
        "signature_scheme": {
          "$ref": "#/$defs/nonempty_string"
        },
        "accepted_signature_form": {
          "$ref": "#/$defs/nonempty_string"
        },
        "authorization_set_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "test_vectors": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "candidate_authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "parameters"
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/selection_candidate_authentication_mode"
        },
        "parameters": {
          "$ref": "#/$defs/selection_candidate_authentication_parameters"
        }
      }
    },
    "slot_construction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settlement_interval_ms",
        "block_interval_ms",
        "blocks_per_settlement_interval",
        "proof_budget_ms",
        "submission_slack_ms",
        "max_catch_up_blocks"
      ],
      "properties": {
        "settlement_interval_ms": {
          "$ref": "#/$defs/selection_positive_integer",
          "description": "D1, the nominal settlement-network interval in milliseconds."
        },
        "block_interval_ms": {
          "$ref": "#/$defs/selection_positive_integer",
          "description": "D2, the execution-network block interval in milliseconds."
        },
        "blocks_per_settlement_interval": {
          "$ref": "#/$defs/selection_positive_integer",
          "description": "K, which must equal D1 divided by D2."
        },
        "proof_budget_ms": {
          "$ref": "#/$defs/selection_positive_integer",
          "description": "P, the candidate-construction and proof budget in milliseconds."
        },
        "submission_slack_ms": {
          "$ref": "#/$defs/selection_nonnegative_integer",
          "description": "S, the required submission lead time in milliseconds."
        },
        "max_catch_up_blocks": {
          "$ref": "#/$defs/selection_positive_integer",
          "description": "C, the producer-side maximum blocks emitted at one catch-up trigger. This is not a candidate-range validity bound."
        }
      }
    },
    "competition_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "ordering_rule",
        "conflict_rule",
        "stale_candidate_rule"
      ],
      "properties": {
        "mode": {
          "enum": [
            "first-valid",
            "priority",
            "leader-election",
            "single-authority",
            "other"
          ]
        },
        "ordering_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "conflict_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "stale_candidate_rule": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "settlement_relay_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "authorization_rule",
        "submission_rule",
        "failure_rule"
      ],
      "properties": {
        "mode": {
          "enum": [
            "permissionless",
            "permissioned",
            "single-authority"
          ]
        },
        "authorization_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "submission_rule": {
          "$ref": "#/$defs/nonempty_string"
        },
        "failure_rule": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "system_address_safety_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "can_execute_code",
        "prevents_reentrant_table_replacement",
        "enforces_single_inbound_call_per_transaction",
        "enforcement",
        "failure_rule"
      ],
      "properties": {
        "mode": {
          "enum": [
            "node-controlled-non-reentrant",
            "contract-guarded"
          ]
        },
        "can_execute_code": {
          "type": "boolean"
        },
        "prevents_reentrant_table_replacement": {
          "const": true
        },
        "enforces_single_inbound_call_per_transaction": {
          "const": true
        },
        "enforcement": {
